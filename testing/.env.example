# Kalshi API credentials
# Fill these in with your real values

KALSHI_API_KEY_ID=your-api-key-id-here
KALSHI_PRIVATE_KEY_PATH=/path/to/your/private_key.pem

# Optional: override the API host (default: api.elections.kalshi.com)
# KALSHI_HOST=https://api.elections.kalshi.com/trade-api/v2

# Optional: set to 1 for verbose HTTP debug output
# KALSHI_DEBUG=1
